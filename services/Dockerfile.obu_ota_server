FROM python:3.12-alpine

WORKDIR /home

COPY addons/images/obu_ota_server/requirements.txt .
RUN pip install --no-cache-dir --upgrade -r requirements.txt

COPY addons/images/obu_ota_server/*.py .
COPY common/*.py ./common/

# --proxy-headers trusts X-Forwarded-For from the hosts in FORWARDED_ALLOW_IPS so the
# real OBU address is logged instead of the NGINX proxy address
CMD ["uvicorn", "obu_ota_server:app", "--host", "0.0.0.0", "--port", "8085", "--proxy-headers"]